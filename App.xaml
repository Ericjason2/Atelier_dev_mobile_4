<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KoutaCalculator.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="PageBackground">#10141D</Color>
      <Color x:Key="PanelBackground">#1B2331</Color>
      <Color x:Key="KeyBackground">#273244</Color>
      <Color x:Key="OperatorBackground">#FF9F0A</Color>
      <Color x:Key="TextPrimary">#F7F8FA</Color>
      <Color x:Key="TextMuted">#AAB5C8</Color>
      <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource KeyBackground}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="MinimumHeightRequest" Value="56" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
