<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KoutaCalculator.MainPage"
             BackgroundColor="{StaticResource PageBackground}">
  <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <VerticalStackLayout Grid.Row="0" Spacing="6">
      <Label Text="KOUTA CALCULATOR" TextColor="{StaticResource TextMuted}" FontAttributes="Bold" FontSize="13" />
      <Border Background="{StaticResource PanelBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18">
        <VerticalStackLayout Spacing="8">
          <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <Label x:Name="ExpressionLabel" Text="" TextColor="{StaticResource TextMuted}" FontSize="18" LineBreakMode="NoWrap" />
          </ScrollView>
          <Label x:Name="DisplayLabel" Text="0" TextColor="{StaticResource TextPrimary}" FontSize="48" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>

    <Grid Grid.Row="1" RowDefinitions="Auto,*,*,*,*" ColumnDefinitions="*,*,*,*" RowSpacing="4" ColumnSpacing="4">
      <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="4" Spacing="4">
        <Button Text="C" Clicked="OnClearClicked" BackgroundColor="#D95D5D" HorizontalOptions="FillAndExpand" />
        <Button Text="⌫" Clicked="OnBackspaceClicked" HorizontalOptions="FillAndExpand" />
        <Button Text="±" Clicked="OnSignClicked" HorizontalOptions="FillAndExpand" />
        <Button Text="%" Clicked="OnPercentClicked" HorizontalOptions="FillAndExpand" />
      </HorizontalStackLayout>
      <Button Grid.Row="1" Grid.Column="0" Text="7" Clicked="OnDigitClicked" />
      <Button Grid.Row="1" Grid.Column="1" Text="8" Clicked="OnDigitClicked" />
      <Button Grid.Row="1" Grid.Column="2" Text="9" Clicked="OnDigitClicked" />
      <Button Grid.Row="1" Grid.Column="3" Text="/" Clicked="OnOperatorClicked" BackgroundColor="{StaticResource OperatorBackground}" />
      <Button Grid.Row="2" Grid.Column="0" Text="4" Clicked="OnDigitClicked" />
      <Button Grid.Row="2" Grid.Column="1" Text="5" Clicked="OnDigitClicked" />
      <Button Grid.Row="2" Grid.Column="2" Text="6" Clicked="OnDigitClicked" />
      <Button Grid.Row="2" Grid.Column="3" Text="x" Clicked="OnOperatorClicked" BackgroundColor="{StaticResource OperatorBackground}" />
      <Button Grid.Row="3" Grid.Column="0" Text="1" Clicked="OnDigitClicked" />
      <Button Grid.Row="3" Grid.Column="1" Text="2" Clicked="OnDigitClicked" />
      <Button Grid.Row="3" Grid.Column="2" Text="3" Clicked="OnDigitClicked" />
      <Button Grid.Row="3" Grid.Column="3" Text="−" Clicked="OnOperatorClicked" BackgroundColor="{StaticResource OperatorBackground}" />
      <Button Grid.Row="4" Grid.Column="0" Text="0" Clicked="OnDigitClicked" />
      <Button Grid.Row="4" Grid.Column="1" Text="," Clicked="OnDecimalClicked" />
      <Button Grid.Row="4" Grid.Column="2" Text="=" Clicked="OnEqualsClicked" BackgroundColor="#4D9DE0" />
      <Button Grid.Row="4" Grid.Column="3" Text="+" Clicked="OnOperatorClicked" BackgroundColor="{StaticResource OperatorBackground}" />
    </Grid>
    <Label Grid.Row="2" Text="Calculatrice .NET MAUI" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
  </Grid>
</ContentPage>
